# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Object storage (S3-compatible). Backblaze B2: bucket must be Private, key = "Read and Write" on that bucket only.
# Endpoint is shown on the bucket page, e.g. https://s3.us-west-004.backblazeb2.com
# (Cloudflare R2 also works: https://<account-id>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# Supabase (server only, never expose to the browser; no NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin PIN for /admin (use something long, e.g. 8+ digits)
ADMIN_PIN=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional (Phase 4): Gotenberg for Word/PowerPoint/Excel → PDF. Leave empty to disable.
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
