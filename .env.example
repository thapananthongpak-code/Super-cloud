# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Cloudflare R2 (private bucket + API token scoped to that bucket only, Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase (server only, never expose to the browser; no NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin PIN for /admin (use something long, e.g. 8+ digits)
ADMIN_PIN=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional (Phase 4): Gotenberg for Word/PowerPoint/Excel → PDF. Leave empty to disable.
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
